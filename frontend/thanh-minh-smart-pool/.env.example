# URL gốc của Backend API
# - Development: để nguyên http://localhost:PORT — Vite proxy forward /api/* đến đây
# - Production: đổi thành URL deploy thật (https://api.yourapp.com)
VITE_API_BASE_URL=http://localhost:5000

# URL WebSocket/SignalR Hub
# - Development: Vite proxy forward /hubs/* (WebSocket) đến đây  
# - Production: đổi thành URL deploy thật
VITE_SIGNALR_HUB_URL=http://localhost:5000

# Tên ứng dụng
VITE_APP_NAME=Thanh Minh Smart Pool

# Phiên bản ứng dụng
VITE_APP_VERSION=1.0.0

# Timeout cho HTTP request (milliseconds)
VITE_API_TIMEOUT=30000

# Bật/tắt debug mode (true/false)
VITE_DEBUG=false

# C?u h�nh thanh to�n VietQR (SePay)
VITE_VIETQR_BANK_ID=970422
VITE_VIETQR_ACCOUNT_NO=0123456789
VITE_VIETQR_ACCOUNT_NAME=PHAM THE SON
