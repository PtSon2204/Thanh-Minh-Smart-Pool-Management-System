# ---- Database (PostgreSQL) ----
# Format: Host=...;Port=5432;Database=...;Username=...;Password=...
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=smartpool_dev;Username=postgres;Password=your_postgres_password
ConnectionStrings__Redis=localhost:6379,abortConnect=false

# ---- JWT ----
JwtSettings__SecretKey=replace-this-with-random-string-at-least-32-chars
JwtSettings__Issuer=SmartPoolManagementSystem
JwtSettings__Audience=SmartPoolClients
JwtSettings__AccessTokenExpirationMinutes=60
JwtSettings__RefreshTokenExpirationDays=7

# ---- Cloudinary (lấy từ https://cloudinary.com/console) ----
CloudinarySettings__CloudName=your_cloud_name
CloudinarySettings__ApiKey=your_api_key
CloudinarySettings__ApiSecret=your_api_secret

# ---- Email (Gmail: bật 2FA rồi vào myaccount.google.com > App Passwords) ----
EmailSettings__SmtpHost=smtp.gmail.com
EmailSettings__SmtpPort=587
EmailSettings__EnableSsl=true
EmailSettings__Username=your-email@gmail.com
EmailSettings__Password=your-gmail-app-password
EmailSettings__FromEmail=your-email@gmail.com
EmailSettings__FromName=Thanh Minh Smart Pool

# ---- CORS ----
CorsSettings__AllowedOrigins=http://localhost:5173,http://localhost:3000

# ---- Camera: default deny; configure only approved camera endpoints ----
# CameraSettings__AllowedEndpoints__0__Host=<camera-ip-or-hostname>
# CameraSettings__AllowedEndpoints__0__Port=554
# For a hostname, pin every permitted DNS address explicitly:
# CameraSettings__AllowedEndpoints__0__Addresses__0=<approved-camera-ip>
# CameraSettings__FfmpegPath=<absolute-path-to-ffmpeg-executable>
# CameraSettings__KeyRingPath=<persistent-directory-for-encrypted-camera-keys>
CameraSettings__ConnectionTimeoutSeconds=15
CameraSettings__FrameStaleSeconds=15
CameraSettings__ReconnectDelaySeconds=5
CameraSettings__MaxConnections=16
# WebRTC: allow this UDP port range from viewer networks on the backend host.
CameraSettings__WebRtc__PortRangeStart=50000
CameraSettings__WebRtc__PortRangeEnd=50127
# Optional bind IP for multi-NIC/NAT deployments; empty uses available interfaces.
# CameraSettings__WebRtc__BindAddress=<backend-lan-ip>
# LAN normally needs no public ICE server. Configure your own STUN/TURN for other networks.
# CameraSettings__WebRtc__IceServers__0__Urls=stun:<your-stun-host>:3478
# CameraSettings__WebRtc__IceServers__1__Urls=turn:<your-turn-host>:3478
# CameraSettings__WebRtc__IceServers__1__Username=<turn-username>
# CameraSettings__WebRtc__IceServers__1__Credential=<turn-credential>
# On Windows keys are protected with DPAPI for the service account.
# On Linux configure a certificate (and persist it with the key ring):
# CameraSettings__KeyEncryptionCertificatePath=<path-to-pfx>
# CameraSettings__KeyEncryptionCertificatePassword=<from-secret-store>
